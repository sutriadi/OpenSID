# Salin ke docker/.env lalu isi.
OPENSID_IMAGE=ghcr.io/sutriadi/opensid:latest

# Password MariaDB (gunakan nilai acak yang panjang)
DB_ROOT_PASSWORD=
DB_PASSWORD=

# Password admin awal OpenSID (opsional; kosong = dibuatkan acak dan dicetak sekali di log container).
# 8-20 karakter, wajib ada angka, huruf kecil, huruf besar, dan simbol; tanpa spasi.
OPENSID_ADMIN_PASSWORD=

# Domain situs, pisahkan koma bila lebih dari satu (opsional namun dianjurkan), mis. sid.desa.id
OPENSID_TRUSTED_HOSTS=

# Alamat & port di host. Default hanya lokal; taruh reverse proxy TLS di depannya.
WEB_BIND=127.0.0.1
WEB_PORT=8080
